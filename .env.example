# devcrew 환경변수. 이 파일을 `.env`로 복사해 값을 채운다.
#   cp .env.example .env
# `.env`는 gitignore 대상이다. 셸에서 export한 값이 항상 이긴다.

# ── crew 봇 (필수) ──────────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# ── brain 인터뷰 봇 (선택) ─────────────────────────────────────
BRAIN_BOT_TOKEN=
BRAIN_APP_TOKEN=

# ── tutor 학습 봇 (선택) — docs/tutor-setup.md 참고 ─────────────
TUTOR_BOT_TOKEN=
TUTOR_APP_TOKEN=

# ── 리포트 발행 (선택) ─────────────────────────────────────────
# 비우면 리포트를 업로드하지 않고 Slack 본문으로만 회신한다
REPORT_BASE_URL=
