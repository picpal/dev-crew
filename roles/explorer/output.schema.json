{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "affected_files",
    "findings"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "NOT_PASS",
        "NEED_REPLAN",
        "BLOCKED",
        "INSUFFICIENT_CAPABILITY"
      ]
    },
    "summary": {
      "type": "string"
    },
    "affected_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "line",
          "evidence",
          "confidence"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "line": {
            "type": [
              "integer",
              "null"
            ]
          },
          "evidence": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
