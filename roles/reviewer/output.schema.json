      "required": ["severity", "description"],
      "properties": {
        "severity": {"type": "string", "enum": ["critical", "important", "minor"]},
        "file": {"type": ["string", "null"]},
        "line": {"type": ["integer", "null"]},
        "description": {"type": "string"}
      }}}
  }
}
