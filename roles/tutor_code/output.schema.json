{
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "title", "role_of_code", "file",
               "start_line", "end_line", "steps"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["PASS", "NOT_PASS", "NEED_REPLAN", "BLOCKED", "INSUFFICIENT_CAPABILITY"]
    },
    "summary": { "type": "string" },
    "title": { "type": "string" },
    "role_of_code": { "type": "string" },
    "file": { "type": "string" },
    "start_line": { "type": "integer" },
    "end_line": { "type": "integer" },
    "steps": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["line", "reason", "vars"],
        "properties": {
          "line": { "type": "integer" },
          "reason": { "type": "string" },
          "vars": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "value", "changed"],
              "properties": {
                "name": { "type": "string" },
                "value": { "type": "string" },
                "changed": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  }
}
